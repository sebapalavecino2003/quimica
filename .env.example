# ========================================================
# ASISTENTE INTELIGENTE PARA MOODLE - CONFIGURACIÓN
# ========================================================

# Clave de API de Google Gemini (Obtener en https://aistudio.google.com/)
GEMINI_API_KEY=

# Modelo de Google Gemini (Por defecto: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Directorio de perfil persistente para sesión de Chromium
BROWSER_PROFILE_DIR=./browser_data

# Modo visual (headless=False para ver el navegador y permitir login/revisión manual)
HEADLESS=False

